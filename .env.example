# =============================================================================
# RAG Chat Assistant - configuration
# Copy to `.env` and fill in OPENAI_API_KEY:   cp .env.example .env
# Never commit `.env`. It is already listed in .gitignore.
# =============================================================================

# ---- OpenAI ----------------------------------------------------------------
# REQUIRED. Your secret key from https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Chat model used for answering and question rewriting.
OPENAI_MODEL=gpt-4o-mini
# Embedding model. Changing it after ingesting means you must re-ingest
# (vectors from different models are not comparable).
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# 0 = deterministic, factual answers (recommended for RAG).
OPENAI_TEMPERATURE=0
# Seconds before an OpenAI request is aborted.
OPENAI_TIMEOUT_SECONDS=60

# ---- PostgreSQL + pgvector -------------------------------------------------
# SQLAlchemy URL with the psycopg3 driver. Inside docker-compose the host is
# `postgres`; when running the app on your machine use `localhost`.
DATABASE_URL=postgresql+psycopg://rag:rag@localhost:5432/rag
# Name of the PGVector collection that holds your document chunks.
COLLECTION_NAME=rag_documents
# Table used for chat history when MEMORY_BACKEND=postgres (auto-created).
POSTGRES_HISTORY_TABLE=chat_history

# ---- Redis -----------------------------------------------------------------
# Needs the JSON + Search modules: Redis 8+ or Redis Stack.
# Inside docker-compose the host is `redis`.
REDIS_URL=redis://localhost:6379/0
# Prefix for chat-history keys: <prefix><session_id>:<message_id>
REDIS_KEY_PREFIX=chat:
# Seconds until each stored message expires. Empty = never expire.
REDIS_TTL_SECONDS=

# ---- Memory ----------------------------------------------------------------
# Where conversation history is stored: postgres | redis
MEMORY_BACKEND=postgres
# How many past messages are sent to the LLM per request (cost control).
# 10 = the last 5 question/answer pairs. 0 disables history in prompts.
MAX_HISTORY_MESSAGES=10

# ---- Ingestion -------------------------------------------------------------
# Max characters per chunk, and characters shared between neighbouring chunks.
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
# Max size of a single uploaded file via POST /ingest.
MAX_UPLOAD_MB=20

# ---- Retrieval -------------------------------------------------------------
# similarity = closest chunks; mmr = closest but diverse chunks.
SEARCH_TYPE=similarity
# Number of chunks passed to the LLM as context.
RETRIEVER_K=4
# MMR only: candidates fetched before re-ranking, and diversity (0=max, 1=none).
MMR_FETCH_K=20
MMR_LAMBDA=0.5
# Optional: drop chunks whose relevance score (0-1) is below this.
# Only applies to SEARCH_TYPE=similarity. Empty = disabled. Try 0.3-0.5.
SCORE_THRESHOLD=

# ---- App -------------------------------------------------------------------
LOG_LEVEL=INFO
# true = one JSON object per log line (for log aggregators); false = plain text.
LOG_JSON=true
# Origins allowed to call the API from a browser (JSON list).
CORS_ORIGINS=["http://localhost:8501"]

# ---- UI (Streamlit) --------------------------------------------------------
# Where the Streamlit UI finds the API. In docker-compose: http://api:8000
API_URL=http://localhost:8000
